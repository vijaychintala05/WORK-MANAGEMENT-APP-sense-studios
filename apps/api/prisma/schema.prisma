  parentTask Task? @relation("TaskCreationParent", fields: [parentTaskId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  @@unique([organizationId, actorId, key])
  @@map("task_creation_receipts")
}

model TaskSubtaskLink {
