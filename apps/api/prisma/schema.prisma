model Task {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  projectId String? @db.Uuid
  planItemId String? @db.Uuid
  tags String[] @default([])
  checklist Json @default("[]")
  title String @db.VarChar(160)
  description String? @db.VarChar(2000)
  type TaskType
  priority TaskPriority
  status TaskStatus @default(NOT_STARTED)
  reviewRequirement TaskReviewRequirement @default(NONE)
  version Int @default(1)
  dependencyRevision Int @default(0)
  targetDate DateTime @db.Date
  committedDueDate DateTime? @db.Date
  startDate DateTime? @db.Date
  estimatedHours Decimal? @db.Decimal(8,2)
  primaryOwnerEmployeeId String @db.Uuid
  createdById String @db.Uuid
  requiresReassignment Boolean @default(false)
  waitingPreviousStatus TaskStatus?
  waitingReason String? @db.VarChar(1000)
  waitingDelayCause String? @db.VarChar(1000)
  waitingResponsibleParty String? @db.VarChar(160)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  planItem ProjectPlanItem? @relation(fields: [planItemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  primaryOwner Employee @relation("TaskPrimaryOwner", fields: [primaryOwnerEmployeeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy Account @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  collaborators TaskCollaborator[]
  ownerChanges TaskOwnerChange[]
  statusChanges TaskStatusChange[]
  committedDateChanges TaskCommittedDateChange[]
  predecessorDependencies TaskDependency[] @relation("DependentTask")
  successorDependencies TaskDependency[] @relation("PredecessorTask")
  closeoutApproval TaskCloseoutApproval?
  recurrenceRule TaskRecurrenceRule? @relation("RecurrenceSource")
  recurrenceOccurrence TaskRecurrenceOccurrence? @relation("RecurrenceGeneratedTask")
  subtaskLinks TaskSubtaskLink[] @relation("TaskSubtaskParent")
  subtaskLink TaskSubtaskLink? @relation("TaskSubtaskChild")
  creationReceipts TaskCreationReceipt[] @relation("TaskCreationResult")
  childCreationReceipts TaskCreationReceipt[] @relation("TaskCreationParent")
  @@unique([id, organizationId])
  @@index([organizationId, primaryOwnerEmployeeId, status, targetDate, id])
  @@index([organizationId, projectId, status, targetDate, id])
  @@map("tasks")
}

