  approvalRequestsAssigned          ApprovalRequest[]             @relation("ApprovalApprover")
  approvalDelegationsIssued         ApprovalRequest[]             @relation("ApprovalDelegator")
  approvalRequestsDelegated         ApprovalRequest[]             @relation("ApprovalDelegate")
  approvalDecisions                 ApprovalDecision[]            @relation("ApprovalDecider")
  leadsCreated                      Lead[]                        @relation("LeadCreator")
  leadStageChanges                  LeadStageChange[]
